# Alleen voor ontwikkelen op je eigen computer. Een normale installatie gebruikt de setup-wizard
# in de browser en bewaart de koppeling in <DATA_DIR>/config.json.
#
# Leeg laten = de wizard verschijnt bij de eerste start.
# UNIFI_MODE=live            # live of mock (demodata)
# UNIFI_URL=https://192.168.1.1
# UNIFI_API_KEY=
# UNIFI_SITE=default

# DATA_DIR=data
# POLL_SECONDS=60
# RETENTION_DAYS=14

# Drempels overschrijven (standaarden staan in app/config.py), bijvoorbeeld:
# TH_CLIENT_RETRY_WARN=25
# TH_CLIENT_SIGNAL_WARN_24=-75
